<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/astra_black">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <ImageView
                    android:id="@+id/btn_menu"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="@color/astra_orange"
                    android:contentDescription="Abrir menú" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Astra "
                        android:textColor="@color/astra_blue"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fit"
                        android:textColor="@color/white"
                        android:textSize="28sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Stats Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <!-- Heart Rate -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frecuencia cardíaca"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:id="@+id/hr_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="78"
                            android:textColor="@color/astra_orange"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/hr_value"
                            android:layout_alignBottom="@id/hr_value"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="6dp"
                            android:text="lpm"
                            android:textColor="@color/astra_orange"
                            android:textSize="14sp" />
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="@color/astra_orange"
                            android:contentDescription="Icono pulso" />
                    </RelativeLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="maximo hoy"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:alpha="0.6" />
                        <TextView
                            android:id="@+id/max_hr_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="162 lpm"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:alpha="0.8" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Calories -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calorías"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:id="@+id/cal_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="512"
                            android:textColor="@color/astra_orange"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/cal_value"
                            android:layout_alignBottom="@id/cal_value"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="6dp"
                            android:text="kcal"
                            android:textColor="@color/astra_orange"
                            android:textSize="14sp" />
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@android:drawable/ic_menu_compass"
                            app:tint="@color/astra_orange"
                            android:contentDescription="Icono calorías" />
                    </RelativeLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="total"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:alpha="0.6" />
                        <TextView
                            android:id="@+id/total_cal_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1874 kcal"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:alpha="0.8" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Active Time -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiempo activo hoy"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:id="@+id/time_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="57"
                            android:textColor="@color/astra_orange"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/time_value"
                            android:layout_alignBottom="@id/time_value"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="6dp"
                            android:text="min"
                            android:textColor="@color/astra_orange"
                            android:textSize="14sp" />
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@android:drawable/ic_menu_recent_history"
                            app:tint="@color/astra_orange"
                            android:contentDescription="Icono tiempo" />
                    </RelativeLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="total semana"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:alpha="0.6" />
                        <TextView
                            android:id="@+id/total_week_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4d 32min"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:alpha="0.8" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Distance -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Distancia total"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:id="@+id/dist_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6.8"
                            android:textColor="@color/astra_orange"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/dist_value"
                            android:layout_alignBottom="@id/dist_value"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="6dp"
                            android:text="Km"
                            android:textColor="@color/astra_orange"
                            android:textSize="14sp" />
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@android:drawable/ic_menu_directions"
                            app:tint="@color/astra_orange"
                            android:contentDescription="Icono distancia" />
                    </RelativeLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="totales semana"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:alpha="0.6" />
                        <TextView
                            android:id="@+id/total_week_dist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="38.2 km"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:alpha="0.8" />
                    </LinearLayout>
                </LinearLayout>
            </GridLayout>

            <!-- Heart Rate Chart Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/astra_black"
                app:cardElevation="0dp"
                app:cardCornerRadius="4dp"
                android:foreground="@drawable/card_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/card_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="@color/astra_orange"
                            android:contentDescription="Icono tarjeta" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/card_icon"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FRECUENCIA CARDÍACA"
                                android:textColor="@color/astra_orange"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/avg_hr_chart"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PROMEDIO 78 LPM"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:alpha="0.6" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/card_border"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="HOY ⌵"
                            android:textColor="@color/white"
                            android:textSize="10sp" />
                    </RelativeLayout>

                    <!-- Chart Placeholder -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/chart_bg_alpha" />

                        <!-- Marker placeholder -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:layout_marginTop="-20dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/card_border"
                                android:paddingHorizontal="4dp"
                                android:text="112 LPM"
                                android:textColor="@color/astra_orange"
                                android:textSize="8sp" />
                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@color/astra_orange"
                                android:rotation="45" />
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bottom Icons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:src="@android:drawable/ic_menu_save"
                    app:tint="@color/astra_yellow"
                    android:contentDescription="Acción 1" />
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:src="@android:drawable/ic_lock_silent_mode"
                    app:tint="@color/astra_pink"
                    android:contentDescription="Acción 2" />
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="@color/astra_red"
                    android:contentDescription="Acción 3" />
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="@color/astra_accent_orange"
                    android:contentDescription="Acción 4" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/astra_black"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/nav_item_color_selector"
        app:itemTextColor="@color/nav_item_color_selector"
        app:itemBackground="@drawable/nav_item_background"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>